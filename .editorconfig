root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h}]
end_of_line = crlf
indent_style = tab
indent_size = 4

[*.{bat,ps1,rc,sln}]
end_of_line = crlf
indent_style = tab
indent_size = 4

[*.{vcxproj,filters}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
