* text=auto

*.bat text eol=crlf
*.cpp text eol=crlf
*.h text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf

*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.ico binary
*.lib binary
*.png binary
*.tga binary
*.zip binary

# Preserve the supplied legacy SDK byte-for-byte and do not apply this
# repository's whitespace policy to upstream files.
third_party/cssv34-sdk/public/** -text -whitespace
third_party/cssv34-sdk/UPSTREAM_README.md -text -whitespace
